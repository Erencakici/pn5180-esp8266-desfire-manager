<Window x:Class="DesfireManager.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Profil Yönetimi / Profile Manager"
        Width="800" Height="860"
        MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackground}"
        Icon="Assets/app.png"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="EditorSection" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18,16" />
        </Style>

        <Style x:Key="EditorLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.FieldLabel}">
            <Setter Property="Margin" Value="2,0,0,7" />
        </Style>

        <Style x:Key="EditorInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>

        <Style x:Key="NumericInput" TargetType="TextBox" BasedOn="{StaticResource EditorInput}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="MonoInput" TargetType="TextBox" BasedOn="{StaticResource EditorInput}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="MonoPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="PasswordChar" Value="*" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="{StaticResource SurfaceInput}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="EditorCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
            <Setter Property="FontSize" Value="14.5" />
        </Style>

        <Style x:Key="SectionCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="RightsHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RightsCode" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Ellipse Width="460" Height="340" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-190,-90,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#213B82F6" Offset="0" />
                    <GradientStop Color="#003B82F6" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Border Grid.Row="0" Background="#0B121A" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Image Source="Assets/app.png" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Profil Yönetimi / Profile Manager" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Kart profilleri / Card profiles" FontSize="10.5" Margin="0,1,0,0"
                                   Foreground="{StaticResource TextMuted}" />
                    </StackPanel>
                </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource Button.TitleBarClose}"
                        Content="&#xE8BB;" ToolTip="Kapat / Close" Click="CloseButton_Click"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,24,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource EditorSection}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="PROFİL / PROFILE" Style="{StaticResource Text.SectionLabel}" Margin="2,0,0,7" />
                        <ComboBox x:Name="ProfileCombo" Style="{StaticResource EditorCombo}"
                                  Tag="Profil seçin / Select profile"
                                  SelectionChanged="ProfileCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="NewButton" Content="Yeni Profil / New"
                            Style="{StaticResource Button.Secondary}" Height="40"
                            Click="NewButton_Click" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel>

                    <Border Style="{StaticResource EditorSection}">
                        <StackPanel>
                            <TextBlock Text="Genel / General" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Profilin görünen adı ve uygulama ayarları / Profile name and app settings."
                                       Style="{StaticResource SectionCaption}" />

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Profil Adı" Style="{StaticResource EditorLabel}" />
                                <TextBox x:Name="NameBox" Style="{StaticResource EditorInput}"
                                         Tag="Örn. ABC Firması" MaxLength="80" />
                                <TextBlock Text="Adı değiştirip Kaydet'e basarak profili yeniden adlandırabilirsiniz / Edit the name and Save to rename."
                                           Style="{StaticResource Text.Hint}" Margin="2,5,0,0" />
                            </StackPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Uygulama AID" Style="{StaticResource EditorLabel}" />
                                    <TextBox x:Name="AidBox" Style="{StaticResource MonoInput}"
                                             Tag="F20111" MaxLength="6" Height="40" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Algoritma" Style="{StaticResource EditorLabel}" />
                                    <ComboBox x:Name="AlgoBox" Style="{StaticResource EditorCombo}">
                                        <ComboBoxItem Content="AES" Tag="aes" />
                                        <ComboBoxItem Content="DES" Tag="des" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Anahtar Sayısı" Style="{StaticResource EditorLabel}" />
                                    <TextBox x:Name="KeyCountBox" Style="{StaticResource NumericInput}"
                                             Tag="5" MaxLength="2" Height="40" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,15,0,0">
                                <CheckBox x:Name="FormatCheckBox" Content="Kartı önce formatla" />
                                <TextBlock Text="PICC anahtarıyla kimlik doğrulama ve format adımı çalıştırılır."
                                           Style="{StaticResource Text.Hint}" Margin="30,5,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource EditorSection}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Anahtarlar / Keys" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="AES anahtarları 32, DES anahtarları 16 hex karakter olmalıdır / AES 32 hex, DES 16 hex."
                                       Style="{StaticResource SectionCaption}" />

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Uygulama Master Anahtarı" Style="{StaticResource EditorLabel}" />
                                <PasswordBox x:Name="AppMasterBox" Style="{StaticResource MonoPassword}" Height="40" MaxLength="64" />
                            </StackPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource EditorLabel}">
                                        <Run Text="Yeni Master Anahtarı" />
                                        <Run Text="   opsiyonel" Foreground="{StaticResource TextMuted}" />
                                    </TextBlock>
                                    <PasswordBox x:Name="NewMasterBox" Style="{StaticResource MonoPassword}" Height="40" MaxLength="64" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource EditorLabel}">
                                        <Run Text="PICC Master Anahtarı" />
                                        <Run Text="   opsiyonel" Foreground="{StaticResource TextMuted}" />
                                    </TextBlock>
                                    <PasswordBox x:Name="PiccMasterBox" Style="{StaticResource MonoPassword}" Height="40" MaxLength="64" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource EditorSection}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Türetme ve PICC / Diversification &amp; PICC" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Kart anahtarlarını türet ve PICC master anahtarını değiştir / Diversify keys and change the PICC master key."
                                       Style="{StaticResource SectionCaption}" />

                            <StackPanel Margin="0,14,0,0">
                                <CheckBox x:Name="DiversifyCheckBox" Content="Anahtarları türet (diversification)" />
                                <TextBlock Text="Her kart için UID'den benzersiz anahtar üretilir; okuma anahtarı sabit kalır / Per-card keys from UID; read key stays fixed."
                                           Style="{StaticResource Text.Hint}" Margin="30,5,0,0" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource EditorLabel}">
                                    <Run Text="Türetme Master Anahtarı" />
                                    <Run Text="   opsiyonel" Foreground="{StaticResource TextMuted}" />
                                </TextBlock>
                                <PasswordBox x:Name="DivMasterBox" Style="{StaticResource MonoPassword}" Height="40" MaxLength="64" />
                            </StackPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PICC Master Değiştir" Style="{StaticResource EditorLabel}" />
                                    <ComboBox x:Name="PiccModeBox" Style="{StaticResource EditorCombo}">
                                        <ComboBoxItem Content="Yok / None" Tag="none" />
                                        <ComboBoxItem Content="Sabit / Fixed" Tag="fixed" />
                                        <ComboBoxItem Content="Türetilmiş / Diversified" Tag="diversified" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PICC Tip / Type" Style="{StaticResource EditorLabel}" />
                                    <ComboBox x:Name="PiccTypeBox" Style="{StaticResource EditorCombo}">
                                        <ComboBoxItem Content="DES" Tag="des" />
                                        <ComboBoxItem Content="AES" Tag="aes" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource EditorLabel}">
                                    <Run Text="PICC Yeni Anahtar" />
                                    <Run Text="   Sabit icin / for Fixed" Foreground="{StaticResource TextMuted}" />
                                </TextBlock>
                                <PasswordBox x:Name="PiccNewBox" Style="{StaticResource MonoPassword}" Height="40" MaxLength="64" />
                            </StackPanel>

                            <Border Background="#2A1418" BorderBrush="#6B2430" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
                                <TextBlock TextWrapping="Wrap" Foreground="#FCA5A5" FontSize="11.5"
                                           Text="DİKKAT: PICC master değişimi GERİ ALINAMAZ. Anahtar kaybı veya yanlış değer kartı KALICI olarak kilitler. / WARNING: PICC master change is IRREVERSIBLE; a lost or wrong key PERMANENTLY bricks the card." />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource EditorSection}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Dosya / File" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Yalnızca ilk dosya düzenlenir; diğer dosyalar korunur / Only first file is edited."
                                       Style="{StaticResource SectionCaption}" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Dosya ID" Style="{StaticResource EditorLabel}" />
                                    <TextBox x:Name="FileIdBox" Style="{StaticResource NumericInput}"
                                             Tag="0" MaxLength="2" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Boyut (byte)" Style="{StaticResource EditorLabel}" />
                                    <TextBox x:Name="FileSizeBox" Style="{StaticResource NumericInput}"
                                             Tag="14" MaxLength="5" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Haberleşme" Style="{StaticResource EditorLabel}" />
                                    <TextBox x:Name="CommBox" Style="{StaticResource NumericInput}"
                                             Tag="0 veya 3" MaxLength="1" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,16,0,14" />

                            <TextBlock Text="ERİŞİM YETKİLERİ VE ANAHTARLAR / ACCESS RIGHTS &amp; KEYS"
                                       Style="{StaticResource Text.SectionLabel}" Margin="2,0,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Yetki"
                                           Style="{StaticResource RightsHeader}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Yuva"
                                           Style="{StaticResource RightsHeader}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Anahtar"
                                           Style="{StaticResource RightsHeader}" Margin="2,0,0,0" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Style="{StaticResource RightsCode}" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="RBox" Style="{StaticResource NumericInput}"
                                         Tag="0" MaxLength="2" />
                                <PasswordBox Grid.Row="0" Grid.Column="3" x:Name="RKeyBox" Style="{StaticResource MonoPassword}" MaxLength="64" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="W" Style="{StaticResource RightsCode}" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="WBox" Style="{StaticResource NumericInput}"
                                         Tag="0" MaxLength="2" />
                                <PasswordBox Grid.Row="2" Grid.Column="3" x:Name="WKeyBox" Style="{StaticResource MonoPassword}" MaxLength="64" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="RW" Style="{StaticResource RightsCode}" />
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="RwBox" Style="{StaticResource NumericInput}"
                                         Tag="0" MaxLength="2" />
                                <PasswordBox Grid.Row="4" Grid.Column="3" x:Name="RwKeyBox" Style="{StaticResource MonoPassword}" MaxLength="64" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="CAR" Style="{StaticResource RightsCode}" />
                                <TextBox Grid.Row="6" Grid.Column="1" x:Name="CarBox" Style="{StaticResource NumericInput}"
                                         Tag="0" MaxLength="2" />
                                <PasswordBox Grid.Row="6" Grid.Column="3" x:Name="CarKeyBox" Style="{StaticResource MonoPassword}" MaxLength="64" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,16,0,14" />

                            <TextBlock Text="KART NUMARASI KONUMU"
                                       Style="{StaticResource Text.SectionLabel}" Margin="2,0,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Başlangıç (byte)" Style="{StaticResource EditorLabel}" />
                                    <TextBox x:Name="CardOffsetBox" Style="{StaticResource NumericInput}"
                                             Tag="4" MaxLength="5" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Uzunluk (byte)" Style="{StaticResource EditorLabel}" />
                                    <TextBox x:Name="CardByteLenBox" Style="{StaticResource NumericInput}"
                                             Tag="10" MaxLength="5" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Bayt Sırası" Style="{StaticResource EditorLabel}" />
                                    <ComboBox x:Name="EndianBox" Style="{StaticResource EditorCombo}">
                                        <ComboBoxItem Content="Big endian" Tag="big" />
                                        <ComboBoxItem Content="Little endian" Tag="little" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Kart numarası, dosya içeriğine bu konumdan yazılır ve okunur."
                                       Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </Border>

                    <Border Height="2" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#0B121A"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="DeleteButton" Content="Sil" Height="40" Padding="20,0"
                        Style="{StaticResource Button.Danger}"
                        Background="#2A1418" BorderBrush="#6B2430" Foreground="#FCA5A5"
                        Click="DeleteButton_Click" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="18,0,16,0">
                    <Ellipse x:Name="EditorStatusDot" Width="7" Height="7" Margin="0,1,8,0"
                             Fill="{StaticResource TextMuted}" Visibility="Collapsed" />
                    <TextBlock x:Name="EditorStatusText" FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="2" Content="Kapat" Height="40"
                        Style="{StaticResource Button.Ghost}"
                        Click="CloseButton_Click" />

                <Button Grid.Column="4" x:Name="SaveButton" Content="Kaydet"
                        Style="{StaticResource Button.Primary}"
                        Height="40" Width="132" FontSize="13.5"
                        Click="SaveButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
