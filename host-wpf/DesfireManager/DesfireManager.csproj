<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DesfireManager</AssemblyName>
    <RootNamespace>DesfireManager</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>DESFire Manager</AssemblyTitle>
    <Product>DESFire Manager</Product>
    <Company>Eren Çakıcı</Company>
    <Authors>Eren Çakıcı</Authors>
    <Description>DESFire Kart Hazırlama ve Okuma Aracı / DESFire Card Preparation &amp; Read Tool</Description>
    <Copyright>© 2026 Eren Çakıcı</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="profiles.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
