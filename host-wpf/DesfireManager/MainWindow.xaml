<Window x:Class="DesfireManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DESFire Manager"
        Width="920" Height="850"
        MinWidth="790" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackground}"
        Icon="Assets/app.png"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="2" ClipToBounds="True" IsHitTestVisible="False">
            <Ellipse Width="720" Height="540" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-180,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#263B82F6" Offset="0" />
                        <GradientStop Color="#003B82F6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="520" Height="420" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-220,0,0,-230">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1F8B5CF6" Offset="0" />
                        <GradientStop Color="#008B5CF6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Border Grid.Row="0" Background="#0B121A" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Image Source="Assets/app.png" Width="30" Height="30"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DESFire Manager" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Kart Hazırlama" FontSize="10.5" Margin="0,1,0,0"
                                   Foreground="{StaticResource TextMuted}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Style="{StaticResource Button.TitleBar}"
                            Content="&#xE921;" ToolTip="Küçült" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource Button.TitleBar}"
                            Content="&#xE922;" ToolTip="Büyüt" Click="MaximizeButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource Button.TitleBarClose}"
                            Content="&#xE8BB;" ToolTip="Kapat" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26,20,26,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,13" CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="28" Height="28" VerticalAlignment="Center">
                            <Ellipse x:Name="ConnectionGlow" Width="24" Height="24"
                                     Stroke="{StaticResource Amber}" StrokeThickness="1.2" Opacity="0.3"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse x:Name="ConnectionDot" Width="10" Height="10"
                                     Fill="{StaticResource Amber}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BAĞLANTI / CONNECTION" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,3" />
                            <TextBlock x:Name="ConnectionText" Text="Bağlanıyor..."
                                       FontSize="13.5" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ReconnectButton" Style="{StaticResource Button.Secondary}"
                                Height="34" Padding="14,0" Click="ReconnectButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Yeniden Bağlan / Reconnect" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ManageProfilesButton" Style="{StaticResource Button.Ghost}"
                                Height="34" Margin="6,0,0,0" Click="ManageProfilesButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Profil Yönetimi / Profiles" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="InfoButton" Style="{StaticResource Button.Ghost}"
                                Height="34" Margin="6,0,0,0" Click="InfoButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Bilgi / Info" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24,22">
                <StackPanel>
                    <TextBlock Text="İşlemler / Operations" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="Profil seçin, veriyi girin ve kartı hazırlayın / Select a profile, enter the data and prepare the card."
                               Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />

                    <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,18,0,18" />

                    <TextBlock Text="Yapılandırma / Configuration" Style="{StaticResource Text.FieldLabel}" />
                    <ComboBox x:Name="ProfileCombo" Tag="Profil seçin / Select profile" Height="44">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Veri / Data" Style="{StaticResource Text.FieldLabel}" Margin="2,0,0,7" />
                            <TextBox x:Name="CardNumberBox" Height="52" FontSize="19" FontWeight="SemiBold"
                                     Tag="Veriyi girin / Enter data"
                                     PreviewKeyDown="CardNumberBox_PreviewKeyDown" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <Button x:Name="ImportBatchButton" Style="{StaticResource Button.Ghost}"
                                    Height="40" Padding="16,0" Click="ImportBatchButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B5;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Toplu İçe Aktar / Import List" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StartBatchButton" Style="{StaticResource Button.Secondary}"
                                    Height="40" Padding="16,0" Margin="0,6,0,0" Click="StartBatchButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Seri Başlat / Start Batch" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DownloadSampleButton" Style="{StaticResource Button.Ghost}"
                                    Height="40" Padding="16,0" Margin="0,6,0,0" Click="DownloadSampleButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Örnek İndir / Sample" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PrepareButton" Grid.Column="0"
                                Style="{StaticResource Button.Primary}"
                                Click="PrepareButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="KARTI HAZIRLA / PREPARE" />
                                <Border Background="#33FFFFFF" CornerRadius="6" Padding="7,2"
                                        Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Enter" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="White" Opacity="0.9" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ReadButton" Grid.Column="2"
                                Style="{StaticResource Button.Purple}"
                                Content="OKU / READ"
                                Click="ReadButton_Click" />

                        <Button x:Name="FormatButton" Grid.Column="4"
                                Style="{StaticResource Button.Secondary}"
                                Content="FORMATLA / FORMAT"
                                Click="FormatButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="StatusBanner" Grid.Row="4" Height="54"
                    Background="{StaticResource StatusNeutralBg}"
                    BorderBrush="{StaticResource StatusNeutralBorder}"
                    BorderThickness="1" CornerRadius="12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,1,10,0"
                             Fill="{StaticResource StatusNeutralDot}" />
                    <TextBlock x:Name="StatusText" Text="Hazır" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource StatusNeutralText}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="6" Style="{StaticResource Card}" Padding="18,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="11" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    <TextBlock Text="İşlem Günlüğü / Log" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Grid.Column="1" Text="Canlı akış / Live" Style="{StaticResource Text.Caption}"
                               FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="2" Background="{StaticResource SurfaceConsole}"
                            BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                            CornerRadius="12" Padding="14,12">
                        <TextBox x:Name="LogBox" Style="{StaticResource TextBox.Console}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
